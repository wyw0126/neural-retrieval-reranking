MODEL_BIENCODER=models/minilm-msmarco-e2-hn
MODEL_RERANKER=checkpoints/e6_a_listwise/checkpoint-300
FAISS_INDEX=data/indexes/faiss/minilm_e2_flatip.faiss
COLLECTION_PATH=data/raw/msmarco/collection.tsv
DOCUMENT_STORE=data/processed/msmarco/documents.sqlite3
MODEL_DEVICE=cuda
FAISS_DEVICE=cpu
FAISS_GPU_ID=0
EMBEDDING_DIM=384
MAX_LENGTH=256
RERANK_BATCH_SIZE=64
RETRIEVE_TOP_K=100
RERANK_TOP_K=10
MAX_CONCURRENT_SEARCHES=1
LOG_LEVEL=INFO
COLLECTION_SHA256=86e0c5820be6b22280337a67e54cbb626645453d9ac3c377bac45abb81c5653d

# Optional generation API (required only for RAG/Agent)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=2
LLM_JSON_RETRIES=1

# RAG evidence budget (default counter: UTF-8 bytes, not actual tokens)
RAG_CONTEXT_BUDGET=6000
RAG_DOCUMENT_BUDGET=1200
RAG_MIN_DOCUMENT_BUDGET=64
RAG_MAX_EVIDENCE=10
RAG_DEDUP_THRESHOLD=0.90

RAG_PROMPT_BUDGET_BYTES=16000
RAG_PROMPT_RETRY_RESERVE_BYTES=2048

# Optional second LLM call to judge cited evidence support
RAG_SEMANTIC_VALIDATION=false

# Opt-in HTTP RAG endpoint; retrieval works without LLM credentials
RAG_ENABLED=false
RAG_MAX_CONCURRENT_REQUESTS=4
RAG_REQUEST_TIMEOUT=120
